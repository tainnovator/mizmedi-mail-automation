# ============================================================
# 미즈메디병원 업무 메일 자동화 - 환경변수 예시
# ============================================================
# 사용법:
#   1) 이 파일을 복사해서 .env 파일을 만든다.
#        cp .env.example .env
#   2) 아래 빈 값을 채운다.
#   3) .env 파일은 절대 git에 커밋하지 않는다 (.gitignore에 등록됨).
#
# 참고: Gmail OAuth 클라이언트 ID / 보안비밀번호는 여기 넣지 않는다.
#       credentials/ 폴더 안의 client_secret_*.json 파일에서 직접 읽는다.
# ============================================================

# --- Gmail ---
# 자동화가 읽어들일 대상 Gmail 주소 (받은편지함을 조회할 계정)
TARGET_GMAIL_ADDRESS=

# 회신 초안(임시보관함)을 만들 계정. 재인증 시 이 계정으로 로그인해야 한다.
# 로그인 계정이 이 값과 다르면 초안 생성이 거부된다(엉뚱한 메일함 방지).
# 보통 TARGET_GMAIL_ADDRESS 와 같은 계정으로 맞춘다.
GMAIL_DRAFT_ACCOUNT=tai.roh@mizmedi.com

# 조회할 메일 라벨/쿼리 (선택, 기본값 사용 시 비워둬도 됨)
# 예: "in:inbox newer_than:1d"
GMAIL_QUERY=

# --- 분류용 LLM (Anthropic Claude) ---
# https://console.anthropic.com/ 에서 발급받은 API 키 (sk-ant-...)
# 규칙으로 애매한 메일을 claude-sonnet-4-6 모델로 분류할 때 사용한다.
ANTHROPIC_API_KEY=

# --- 카카오톡 알림 (이후 단계에서 사용) ---
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 개발자 콘솔 > 보안 > Client Secret (활성화한 경우에만 입력)
# 활성화 상태인데 비워두면 토큰 발급 시 KOE010(invalid_client) 에러가 난다.
KAKAO_CLIENT_SECRET=

# 카카오 로그인 Redirect URI (개발자 콘솔에 등록한 값과 동일해야 함)
# 예: http://localhost:8080/oauth
KAKAO_REDIRECT_URI=

# 카카오 리프레시 토큰 (최초 1회 인증 후 발급받아 저장)
KAKAO_REFRESH_TOKEN=

# 알림을 받을 대상 (나에게 보내기 사용 시 비워둬도 됨)
KAKAO_TARGET=

# --- 일반 설정 ---
# 요약 리포트 저장 폴더
REPORT_DIR=reports

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
